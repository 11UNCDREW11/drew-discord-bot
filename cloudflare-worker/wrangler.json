{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drew-autobot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-22",
  "keep_vars": true,
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drew-league",
      "database_id": "PASTE-YOUR-D1-DATABASE-ID-HERE"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "drew-screenshots"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
